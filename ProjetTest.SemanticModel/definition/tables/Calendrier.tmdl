	column 'Année-Mois'
		dataType: string
		isNameInferred
		lineageTag: 8f7fa3d5-67d3-4f64-849b-e5e70ee929d7
		summarizeBy: none
		sourceColumn: [Année-Mois]

		annotation SummarizationSetBy = Automatic

	column 'Début du mois'
		dataType: dateTime
		isNameInferred
		formatString: Short Date
		lineageTag: e5b21e96-6d07-4849-abbd-adddf79948e0
		summarizeBy: none
		sourceColumn: [Début du mois]

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition Calendrier = calculated
		mode: import
		source =
				VAR Debut = DATE(YEAR(MIN(Ventes[date_vente])), 1, 1)
				VAR Fin = DATE(YEAR(MAX(Ventes[date_vente])), 12, 31)
				RETURN
				    ADDCOLUMNS(
				        CALENDAR(Debut, Fin),
				        "Année", YEAR([Date]),
				        "Trimestre", "T" & QUARTER([Date]),
				        "Mois n°", MONTH([Date]),
				        "Mois", FORMAT([Date], "mmm"),
				        "Année-Mois", FORMAT([Date], "yyyy-mm"),
				        "Début du mois", DATE(YEAR([Date]), MONTH([Date]), 1)
				    )

