	measure 'Libellé évol. CA' =
			VAR N1 = [CA N-1]
			VAR Evol = DIVIDE([Chiffre d'affaires] - N1, N1)
			RETURN
			    IF(
			        ISBLANK(N1) || N1 = 0,
			        "— vs N-1",
			        IF(Evol >= 0, "▲ ", "▼ ") & FORMAT(Evol, "+0.0 %;-0.0 %;0.0 %") & " vs N-1"
			    )
		displayFolder: Affichage
		lineageTag: 06f78555-1750-4141-843f-e57edff4694a

	measure 'Couleur évol. CA' =
			VAR N1 = [CA N-1]
			RETURN IF(ISBLANK(N1) || N1 = 0, "#6F6D68", IF([Chiffre d'affaires] >= N1, "#006300", "#B42727"))
		displayFolder: Affichage
		lineageTag: f00c0c7a-baab-4b80-8aa4-69b0647b238f

