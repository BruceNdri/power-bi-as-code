		lineageTag: 1dca412c-8844-4679-bde4-a6f07811823e

	measure 'Évolution clients actifs (%)' = DIVIDE([Clients actifs] - [Clients actifs N-1], [Clients actifs N-1])
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: Clients
		lineageTag: 92f2f116-efad-49e7-aca4-fadcf6591059

	measure 'Taux de rétention' =
			VAR ClientsN1 = CALCULATETABLE(VALUES(Ventes[id_client]), SAMEPERIODLASTYEAR(Calendrier[Date]))
			VAR ClientsN = VALUES(Ventes[id_client])
			RETURN DIVIDE(COUNTROWS(INTERSECT(ClientsN1, ClientsN)), COUNTROWS(ClientsN1))
		formatString: 0.0 %
		displayFolder: Clients
		lineageTag: 5eaae495-41b7-471e-ae01-a29fa888a200

	measure 'Clients perdus' =
			VAR ClientsN1 = CALCULATETABLE(VALUES(Ventes[id_client]), SAMEPERIODLASTYEAR(Calendrier[Date]))
			VAR ClientsN = VALUES(Ventes[id_client])
			RETURN COUNTROWS(EXCEPT(ClientsN1, ClientsN))
		formatString: #,0
		displayFolder: Clients
		lineageTag: cb5b8852-2d4b-4c62-8e16-8ca6f208f823

	measure 'Date du dernier achat' = MAX(Ventes[date_vente])
