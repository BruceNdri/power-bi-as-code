# Copier en .env puis adapter.
POSTGRES_DB=ventes
POSTGRES_USER=powerbi
POSTGRES_PASSWORD=changez-moi
# 127.0.0.1 = accessible uniquement depuis cette machine.
# Mettre 0.0.0.0 pour que Power BI Desktop (poste Windows) puisse s'y connecter.
POSTGRES_BIND=127.0.0.1
# 5433 pour ne pas entrer en conflit avec un PostgreSQL déjà présent.
POSTGRES_PORT=5433
