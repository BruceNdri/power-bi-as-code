{
  "name": "ProjetTest",
  "dataColors": [
    "#2A78D6",
    "#EB6834",
    "#1BAF7A",
    "#EDA100",
    "#E87BA4",
    "#008300",
    "#6250D6",
    "#E34948"
  ],
  "good": "#0CA30C",
  "neutral": "#F0EFEC",
  "bad": "#D03B3B",
  "maximum": "#2A78D6",
  "center": "#86B6EF",
  "minimum": "#CDE2FB",
  "background": "#FCFCFB",
  "foreground": "#0B0B0B",
  "tableAccent": "#2A78D6",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#0B0B0B"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#52514E"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#52514E"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 20,
      "color": "#0B0B0B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FCFCFB"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E1E0D9"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0B0B0B"
              }
            },
            "fontSize": 11,
            "bold": true
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#6F6D68"
              }
            },
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#E1E0D9"
              }
            },
            "gridlineStyle": "solid",
            "labelColor": {
              "solid": {
                "color": "#6F6D68"
              }
            },
            "showAxisTitle": false
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#6F6D68"
              }
            },
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#52514E"
              }
            },
            "fontSize": 9
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 2
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F4F1"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F4F1"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#52514E"
              }
            },
            "bold": true
          }
        ],
        "grid": [
          {
            "gridHorizontalColor": {
              "solid": {
                "color": "#E1E0D9"
              }
            },
            "gridVertical": false
          }
        ]
      }
    }
  }
}
